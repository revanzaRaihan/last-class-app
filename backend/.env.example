# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database MySQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=last_class_user
DB_PASSWORD=last_class_password
DB_NAME=last_class_db

# ─── Security ─────────────────────────────────────────────────────────────────
# Salt untuk hash IP (isi dengan string acak, minimal 32 karakter)
IP_SALT=isi_dengan_random_string_panjang_disini_contoh_abc123xyz

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Domain frontend kamu (pisah koma kalau lebih dari satu)
ALLOWED_ORIGINS=https://xii-rpl-skarla.lenallen.my.id